# Local configuration for running the watcher outside GitHub Actions.
NINDO_JOBS_EMAIL_TO=mail@example.com
NINDO_JOBS_SMTP_HOST=smtp.example.com
NINDO_JOBS_SMTP_PORT=465
NINDO_JOBS_SMTP_USERNAME=your-smtp-username
NINDO_JOBS_SMTP_PASSWORD=your-smtp-password

# Optional overrides
# NINDO_JOBS_SMTP_SECURITY=starttls
# NINDO_JOBS_SUBJECT_PREFIX=[Nindo Jobs]
